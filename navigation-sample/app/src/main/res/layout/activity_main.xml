<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.libraries.navigation.NavigationView
            android:id="@+id/navigation_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/top_overlay_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#D0111111"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:text="@string/status_ready_text" />

        <!-- Row 1: Start Nav + Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginEnd="4dp"
                android:enabled="false"
                android:textSize="12sp"
                android:text="@string/btn_start_nav_text" />

            <Button
                android:id="@+id/btn_info_start_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="@string/btn_info_text" />
        </LinearLayout>

        <!-- Row 2: Cancel/Exit + Info (Repro Guide) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel_exit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginEnd="4dp"
                android:enabled="false"
                android:textSize="12sp"
                android:text="@string/btn_cancel_exit_text" />

            <Button
                android:id="@+id/btn_info_cancel_exit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="@string/btn_repro_guide_text" />
        </LinearLayout>

        <!-- Row 3: Phone Speed Simulator + Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_toggle_speed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginEnd="4dp"
                android:textSize="12sp"
                android:text="@string/btn_toggle_speed_text" />

            <Button
                android:id="@+id/btn_info_speed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="@string/btn_info_text" />
        </LinearLayout>

        <!-- Row 4: 100% Repro & Workaround + Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_repro_100"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:layout_marginEnd="2dp"
                android:enabled="false"
                android:textSize="11sp"
                android:text="@string/btn_repro_100_text" />

            <Button
                android:id="@+id/btn_test_workaround"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:enabled="false"
                android:textSize="11sp"
                android:text="@string/btn_test_workaround_text" />

            <Button
                android:id="@+id/btn_info_workaround"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="@string/btn_info_text" />
        </LinearLayout>

        <!-- Row 5: Reset Button -->
        <Button
            android:id="@+id/btn_reset_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:text="@string/btn_reset_nav_text" />
    </LinearLayout>

</FrameLayout>
